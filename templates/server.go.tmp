package main

import (
	"github.com/gin-gonic/gin"
	"github.com/jmoiron/sqlx"
)

type Server struct {
	r  *gin.Engine
  db *sqlx.DB
}

func NewServer() (*Server, error) {
  db, err := InitDB()
  if err != nil {
    return nil, err
  }
	s := &Server{
    r:  gin.Default(),
    db: db,
  }
	s.registerRoutes()
	return s, nil
}

func (s *Server) registerRoutes() {
}

func (s *Server) start() error {
	return s.r.Run()
}

func (s *Server) deinit() {
  s.db.Close()
}
