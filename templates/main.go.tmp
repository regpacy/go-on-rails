package main

import (
	"log"

	"github.com/joho/godotenv"
)

func main() {
	err := godotenv.Load()
	if err != nil {
		log.Fatal("Error loading .env file")
	}
	configInit()

	server, err := NewServer()
	if err != nil {
		log.Fatalf("could not start server: %v", err)
	}
	defer server.deinit()

	if err := server.start(); err != nil {
		log.Fatalf("could not start server: %v", err)
	}
}
