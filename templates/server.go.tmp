package main

import (
	"github.com/gin-gonic/gin"
)

type Server struct {
	r *gin.Engine
}

func NewServer() (*Server, error) {
	s := &Server{r: gin.Default()}
	s.registerRoutes()
	return s, nil
}

func (s *Server) registerRoutes() {
}

func (s *Server) start() error {
	return s.r.Run()
}

func (s *Server) deinit() {
}
